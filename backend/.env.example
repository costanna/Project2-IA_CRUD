# Copia este archivo a .env y ajusta los valores. Nunca subas el .env real
# al repositorio (ver .gitignore).

APP_NAME=Academia F5 API
ENVIRONMENT=development

# Postgres en local (ver docker-compose.yml) o tu propia instancia:
DATABASE_URL=postgresql+psycopg2://academia:academia@localhost:5432/academia

SECRET_KEY=super-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

# Email de notificacion de notas via Resend (https://resend.com). Opcional:
# sin clave el envio se desactiva. Con el remitente de pruebas
# onboarding@resend.dev solo se puede enviar al email de tu cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM=Academia F5 <onboarding@resend.dev>

CACHE_TTL_SECONDS=30
LOG_LEVEL=INFO
